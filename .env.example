# ──────────────────────────────────────────────
# DzImmo — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ──────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=production

# Nombre de proxys de confiance devant l'app (1 = Nginx). Laisser vide/0 en local.
# Nécessaire en production pour que les rate limits voient l'IP réelle du client.
TRUST_PROXY=1

# Modération des annonces : on (défaut) = les annonces des utilisateurs ordinaires attendent la
# validation d'un admin ; off = publication directe. Admins et agences vérifiées publient toujours directement.
MODERATION=on

# Signalements : nombre de membres différents (email confirmé, compte de plus de 24 h) qui, en signalant la même annonce,
# la remettent automatiquement en modération. 0 = pas de retrait automatique (les administrateurs sont seulement prévenus).
REPORT_AUTO_HIDE=3

# JWT
JWT_SECRET=changez_ce_secret_par_une_valeur_aleatoire_longue
# Durée d'une session, AVEC son unité : 7d, 12h, 30m (« 3600 » seul vaudrait 3,6 secondes). Défaut : 7d.
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL
DATABASE_URL=postgresql://dzimmo:mot_de_passe@localhost:5433/dzimmo
DATABASE_SSL=false

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

# URL publique de l'application
APP_URL=https://dzimmo.dz

# Dossier PRIVÉ des justificatifs de vérification des annonceurs (jamais servi au public, jamais dans public/).
# Défaut : <projet>/private/verification. Les fichiers y sont supprimés dès la décision de l'administrateur.
# VERIFICATION_DIR=/srv/dzimmo-private/verification

# Connexion avec Google (facultative) : identifiant client OAuth de type « Application Web » (console Google Cloud).
# Absent = pas de bouton Google et aucun accès à Google dans la politique de sécurité. Voir DEPLOIEMENT.md.
# GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com

# Reconfirmation des annonces : rappel après N jours sans confirmation de l'annonceur, retrait M jours plus tard (défauts 30 / 14).
# LISTING_CONFIRM_DAYS=30
# LISTING_EXPIRE_GRACE_DAYS=14

# Email (optionnel — silencieux si absent)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@dzimmo.dz
EMAIL_PASS=mot_de_passe_smtp
# Expéditeur affiché : « Nom <adresse> » ou une adresse seule ; absent ou invalide : le compte EMAIL_USER.
EMAIL_FROM=DzImmo <noreply@dzimmo.dz>
# Destinataire du formulaire de la page Contact ; absent : les comptes administrateurs le reçoivent.
CONTACT_EMAIL=contact@dzimmo.dz

# Double authentification (TOTP) des administrateurs : application d'authentification + codes de secours. Obligatoire par défaut en
# production (un administrateur sans configuration ne peut pas utiliser l'administration avant de l'avoir faite), facultative ailleurs.
# true / false pour forcer. Le secret est chiffré avec une clé dérivée de JWT_SECRET (la changer rend les secrets illisibles).
# ADMIN_2FA_REQUIRED=true

# Supervision : les pannes (plantage, erreur 500, tâche planifiée ou sauvegarde en échec) sont signalées par email, au plus une
# alerte par heure et par nature de panne. Destinataire : ALERT_EMAIL, sinon CONTACT_EMAIL, sinon les administrateurs. Exige le SMTP.
# ALERT_EMAIL=technique@dzimmo.dz

# Sauvegardes PostgreSQL (server/backup.js) : chaque nuit à 02:30, test de restauration chaque dimanche. Actives par défaut en production
# (BACKUP_ENABLED=true pour les activer ailleurs, false pour les couper). Le dossier contient des données personnelles : jamais sous public/.
# BACKUP_ENABLED=true
# BACKUP_DIR=/srv/backups/dzimmo
# BACKUP_KEEP=14
# Dossier `bin` de PostgreSQL si pg_dump / pg_restore ne sont pas dans le PATH (Windows : C:/Program Files/PostgreSQL/17/bin)
# PG_BIN_DIR=/usr/lib/postgresql/17/bin
# Compte PostgreSQL avec le droit CREATEDB pour le test de restauration (base jetable) ; absent : celui de DATABASE_URL, sinon
# contrôle du seul catalogue de l'archive.
# BACKUP_VERIFY_URL=postgresql://sauvegarde:motdepasse@localhost:5432/postgres

# CAPTCHA anti-spam sur les formulaires publics (contact, newsletter) : Cloudflare Turnstile.
# Créez un site sur https://dash.cloudflare.com/ → Turnstile. Choisissez le type « Managed » (invisible).
# Les deux variables doivent être définies ensemble (ou toutes les deux absentes).
# TURNSTILE_SITE_KEY=0x4AAAAAAA…
# TURNSTILE_SECRET=0x4AAAAAAA…

# Mise à la une payante (server/featured.js) : formules « jours:prix » en DZD. Ouverte par défaut en développement (paiement SIMULÉ, aucun argent),
# fermée en production : FEATURED_ENABLED=true y est refusé tant que le paiement SATIM n'est pas raccordé (server/payments.js).
# Un administrateur peut toujours mettre une annonce à la une gratuitement (Administration → Annonces, bouton ⭐).
# FEATURED_ENABLED=false
# FEATURED_PRICES=7:1500,15:2500,30:4000
# Fournisseur de paiement : simulated (développement seulement, refusé en production) ou satim (à raccorder). Défaut : simulated hors production.
# PAYMENT_PROVIDER=satim
