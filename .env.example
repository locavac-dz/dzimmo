# ──────────────────────────────────────────────
# DzImmo — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ──────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=production

# Nombre de proxys de confiance devant l'app (1 = Nginx). Laisser vide/0 en local.
# Nécessaire en production pour que les rate limits voient l'IP réelle du client.
TRUST_PROXY=1

# Modération des annonces : on (défaut) = les annonces des utilisateurs ordinaires attendent la
# validation d'un admin ; off = publication directe. Admins et agences vérifiées publient toujours directement.
MODERATION=on

# Signalements : nombre de membres différents (email confirmé, compte de plus de 24 h) qui, en signalant la même annonce,
# la remettent automatiquement en modération. 0 = pas de retrait automatique (les administrateurs sont seulement prévenus).
REPORT_AUTO_HIDE=3

# JWT
JWT_SECRET=changez_ce_secret_par_une_valeur_aleatoire_longue
# Durée d'une session, AVEC son unité : 7d, 12h, 30m (« 3600 » seul vaudrait 3,6 secondes). Défaut : 7d.
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL
DATABASE_URL=postgresql://dzimmo:mot_de_passe@localhost:5433/dzimmo
DATABASE_SSL=false

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

# URL publique de l'application
APP_URL=https://dzimmo.dz

# Dossier PRIVÉ des justificatifs de vérification des annonceurs (jamais servi au public, jamais dans public/).
# Défaut : <projet>/private/verification. Les fichiers y sont supprimés dès la décision de l'administrateur.
# VERIFICATION_DIR=/srv/dzimmo-private/verification

# Connexion avec Google (facultative) : identifiant client OAuth de type « Application Web » (console Google Cloud).
# Absent = pas de bouton Google et aucun accès à Google dans la politique de sécurité. Voir DEPLOIEMENT.md.
# GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com

# Reconfirmation des annonces : rappel après N jours sans confirmation de l'annonceur, retrait M jours plus tard (défauts 30 / 14).
# LISTING_CONFIRM_DAYS=30
# LISTING_EXPIRE_GRACE_DAYS=14

# Email (optionnel — silencieux si absent)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@dzimmo.dz
EMAIL_PASS=mot_de_passe_smtp
# Expéditeur affiché : « Nom <adresse> » ou une adresse seule ; absent ou invalide : le compte EMAIL_USER.
EMAIL_FROM=DzImmo <noreply@dzimmo.dz>
# Destinataire du formulaire de la page Contact ; absent : les comptes administrateurs le reçoivent.
CONTACT_EMAIL=contact@dzimmo.dz
