# ──────────────────────────────────────────────
# DzImmo — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ──────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=production

# Nombre de proxys de confiance devant l'app (1 = Nginx). Laisser vide/0 en local.
# Nécessaire en production pour que les rate limits voient l'IP réelle du client.
TRUST_PROXY=1

# Modération des annonces : on (défaut) = les annonces des utilisateurs ordinaires attendent la
# validation d'un admin ; off = publication directe. Admins et agences vérifiées publient toujours directement.
MODERATION=on

# JWT
JWT_SECRET=changez_ce_secret_par_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL
DATABASE_URL=postgresql://dzimmo:mot_de_passe@localhost:5433/dzimmo
DATABASE_SSL=false

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

# URL publique de l'application
APP_URL=https://dzimmo.dz

# Dossier PRIVÉ des justificatifs de vérification des annonceurs (jamais servi au public, jamais dans public/).
# Défaut : <projet>/private/verification. Les fichiers y sont supprimés dès la décision de l'administrateur.
# VERIFICATION_DIR=/srv/dzimmo-private/verification

# Email (optionnel — silencieux si absent)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@dzimmo.dz
EMAIL_PASS=mot_de_passe_smtp
EMAIL_FROM=DzImmo <noreply@dzimmo.dz>
